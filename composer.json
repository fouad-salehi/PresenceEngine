{
    "name": "presenceengine/presence-engine",
    "description": "PresenceEngine - Real-time presence tracking system",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "vlucas/phpdotenv": "^5.6",
        "workerman/workerman": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "PresenceEngine\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}